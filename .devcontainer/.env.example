# Copy to .devcontainer/.env before first start. .env is git-ignored; never commit secrets.
# Values here override the defaults baked into the image.

# Host llama-server, for ad-hoc checks. Codex itself reads ~/.codex/config.toml.
LLAMA_SERVER_URL=http://host.docker.internal:9931

# Only needed for hosted models. Codex against local llama-server needs no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
