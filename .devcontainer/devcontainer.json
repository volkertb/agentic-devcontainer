// Generic dev container: Debian + common CLI toolchain, non-root user,
// Claude Code / Codex / SpecStory, and a llama-server on the host.
{
  "name": "generic-dev",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // Override BASE_IMAGE for architectures MCR does not publish (e.g. "debian:trixie" on riscv64).
      "BASE_IMAGE": "mcr.microsoft.com/devcontainers/base:trixie",
      "INSTALL_UV": "true",
      // true also requires removing the no-new-privileges runArg below; see README.
      "ALLOW_SUDO": "false",
      // Safe to bump: both verify against a checksum published upstream.
      // Codex pins its own digests in the Dockerfile instead.
      "UV_VERSION": "0.12.17",
      "SPECSTORY_VERSION": "2.13.0"
    }
  },

  // Features are the portable way to add toolchains; they are OCI artifacts, not Docker-specific.
  // Node exists only for the Claude Code feature; Codex and SpecStory are static binaries.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "remoteUser": "vscode",
  // Realign the container user with your host uid/gid so bind-mounted files stay writable on Linux.
  "updateRemoteUserUID": true,

  "runArgs": [
    // Kernel-enforced: no setuid binary or file capability can ever elevate, whatever
    // a feature or later install puts in the image. Remove this to use ALLOW_SUDO=true.
    "--security-opt=no-new-privileges:true",
    // Docker's default seccomp profile plus the syscalls bubblewrap needs for unprivileged
    // user namespaces, so Codex's Linux sandbox works. Regenerate with make-seccomp.sh.
    // JetBrains IDEs cannot apply this line (IJPL-67749); see README → Codex's Linux sandbox.
    "--security-opt=seccomp=${localWorkspaceFolder}/.devcontainer/seccomp.json",
    // Makes the host reachable as host.docker.internal on native Linux Docker too.
    "--add-host=host.docker.internal:host-gateway",
    // Secrets and per-machine overrides. Copy .env.example to .env before first start.
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ],

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
